# Plantilla de secretos de PRODUCCION. Copiala a infra/.env.pro EN EL SERVIDOR y llena los
# valores ahi. infra/.env.pro esta en .gitignore: nunca debe llegar al repositorio.
#
# Genera los secretos EN EL SERVIDOR:
#   openssl rand -hex 32      para DB_PASSWORD y las llaves de MinIO
#   openssl rand -base64 48   para los secretos JWT
#
# La distincion importa: base64 puede producir "/", que rompe el parseo de
# postgresql://rave:<password>@db:5432/ravedb. Los secretos JWT no van en ninguna URL, asi
# que ahi base64 es seguro y da mas entropia por caracter.
#
# NINGUN valor de este archivo debe coincidir con el de .env.pre. Compartir JWT_ACCESS_SECRET
# entre entornos haria que un token emitido en PRE fuera valido en produccion.

# Identidad del entorno. La lee el frontend en runtime: con APP_ENV=pro no se muestra el
# banner de entorno. Cualquier otro valor lo muestra.
#
# Se deja aqui como documentacion, pero infra/entorno.sh lo deriva del nombre del entorno y
# lo impone al invocar Compose: un dedazo en esta linea no puede hacer que produccion se
# comporte como staging.
APP_ENV=pro

# PostgreSQL
DB_PASSWORD=

# MinIO: credenciales root (solo para administrar el servicio con `mc`)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# MinIO: llave de servicio que usa el backend, acotada al bucket boletos-pdf.
# Se crea una vez con `mc admin user add` + `mc admin policy attach` (runbook, seccion 7).
MINIO_APP_ACCESS_KEY=
MINIO_APP_SECRET_KEY=

# JWT: deben ser distintos entre si y de al menos 32 caracteres, o el backend no arranca.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Dominio publico servido por el tunel, sin https://. Se usa para CORS_ORIGIN y para la
# verificacion externa de desplegar.sh.
PUBLIC_HOSTNAME=www.in-fluence.party

# Token del tunel de Cloudflare (Zero Trust > Networks > Tunnels > el tunel > Install).
# El tunel debe apuntar a http://caddy:80, NO al frontend: Caddy es el borde interno que
# permite conmutar de color sin cortar el trafico.
CLOUDFLARE_TUNNEL_TOKEN=

# Solo para la siembra inicial (seccion 8 del runbook). Se pueden borrar despues.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=

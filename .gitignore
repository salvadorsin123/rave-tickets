# Monorepo root — cada app tiene ademas su propio .gitignore mas especifico.
node_modules/
dist/
.next/
out/
coverage/
*.tsbuildinfo
.env
.env.local
.env.*.local

# Secretos de despliegue (plantillas .example si quedan versionadas)
infra/.env
infra/.env.pre
infra/.env.pro

# Estado local de cada entorno: color activo y sha desplegado. Lo escribe infra/desplegar.sh
# en el servidor y es distinto en cada maquina, asi que no se versiona.
infra/.estado/
infra/caddy/upstream.conf

# Editores / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Configuracion local de Claude Code (especifica de esta maquina/usuario)
.claude/
